 namespace RT64 {
+    // iOS black-screen diagnostic: for the first texture uploads, read back
+    // the TMEM bytes and the decoded texture from the GPU and compare them
+    // with the bytes the CPU uploaded.
+    static uint32_t countNonZero(const uint8_t *bytes, size_t size) {
+        uint32_t count = 0;
+        for (size_t i = 0; i < size; i++) {
+            count += (bytes[i] != 0) ? 1 : 0;
+        }
+
+        return count;
+    }
+
+    template<typename Uploads, typename Additions>
+    static void logUploadReadbacks(RenderWorker *worker, const Uploads &uploads, const Additions &additions) {
+        static uint32_t reported = 0;
+        if (reported >= 6) {
+            return;
+        }
+
+        struct Readback {
+            size_t index;
+            std::unique_ptr<RenderBuffer> tmem;
+            uint32_t tmemBytes = 0;
+            std::unique_ptr<RenderBuffer> decoded;
+            uint32_t decodedRowPitch = 0;
+        };
+
+        std::vector<Readback> readbacks;
+        worker->commandList->begin();
+        for (size_t i = 0; (i < uploads.size()) && (reported + readbacks.size() < 6); i++) {
+            const auto &upload = uploads[i];
+            Texture *texture = additions[i].texture;
+            if (upload.bytesTMEM.empty() || (texture == nullptr) || (texture->tmem == nullptr)) {
+                continue;
+            }
+
+            Readback readback;
+            readback.index = i;
+            readback.tmemBytes = uint32_t(upload.bytesTMEM.size());
+            const uint32_t tmemPitch = (readback.tmemBytes + 255) & ~255U;
+            readback.tmem = worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(tmemPitch));
+            worker->commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(texture->tmem.get(), RenderTextureLayout::COPY_SOURCE));
+            worker->commandList->copyTextureRegion(
+                RenderTextureCopyLocation::PlacedFootprint(readback.tmem.get(), RenderFormat::R8_UINT, readback.tmemBytes, 1, 1, tmemPitch),
+                RenderTextureCopyLocation::Subresource(texture->tmem.get()));
+            if (upload.decodeTMEM && (texture->texture != nullptr)) {
+                readback.decodedRowPitch = ((upload.width * 4) + 255) & ~255U;
+                readback.decoded = worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(uint64_t(readback.decodedRowPitch) * upload.height));
+                worker->commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(texture->texture.get(), RenderTextureLayout::COPY_SOURCE));
+                worker->commandList->copyTextureRegion(
+                    RenderTextureCopyLocation::PlacedFootprint(readback.decoded.get(), RenderFormat::R8G8B8A8_UNORM, upload.width, upload.height, 1, readback.decodedRowPitch / 4),
+                    RenderTextureCopyLocation::Subresource(texture->texture.get()));
+            }
+
+            readbacks.emplace_back(std::move(readback));
+        }
+
+        for (const Readback &readback : readbacks) {
+            Texture *texture = additions[readback.index].texture;
+            worker->commandList->barriers(RenderBarrierStage::GRAPHICS_AND_COMPUTE, RenderTextureBarrier(texture->tmem.get(), RenderTextureLayout::SHADER_READ));
+            if (readback.decoded != nullptr) {
+                worker->commandList->barriers(RenderBarrierStage::GRAPHICS_AND_COMPUTE, RenderTextureBarrier(texture->texture.get(), RenderTextureLayout::SHADER_READ));
+            }
+        }
+
+        worker->commandList->end();
+        worker->execute();
+        worker->wait();
+
+        for (const Readback &readback : readbacks) {
+            const auto &upload = uploads[readback.index];
+            const uint8_t *tmem = reinterpret_cast<const uint8_t *>(readback.tmem->map());
+            std::printf("[ios][texture] upload %u: %ux%u fmt=%u siz=%u decode=%d tmem_bytes=%u cpu_nonzero=%u gpu_nonzero=%u cpu_first=%02X%02X%02X%02X gpu_first=%02X%02X%02X%02X",
+                reported, upload.width, upload.height, unsigned(upload.loadTile.fmt), unsigned(upload.loadTile.siz), upload.decodeTMEM ? 1 : 0,
+                readback.tmemBytes, countNonZero(upload.bytesTMEM.data(), upload.bytesTMEM.size()), countNonZero(tmem, readback.tmemBytes),
+                upload.bytesTMEM[0], upload.bytesTMEM[std::min<size_t>(1, readback.tmemBytes - 1)], upload.bytesTMEM[std::min<size_t>(2, readback.tmemBytes - 1)], upload.bytesTMEM[std::min<size_t>(3, readback.tmemBytes - 1)],
+                tmem[0], tmem[std::min<size_t>(1, readback.tmemBytes - 1)], tmem[std::min<size_t>(2, readback.tmemBytes - 1)], tmem[std::min<size_t>(3, readback.tmemBytes - 1)]);
+            readback.tmem->unmap();
+            if (readback.decoded != nullptr) {
+                const uint8_t *decoded = reinterpret_cast<const uint8_t *>(readback.decoded->map());
+                uint32_t nonZero = 0;
+                for (uint32_t y = 0; y < upload.height; y++) {
+                    nonZero += countNonZero(decoded + uint64_t(y) * readback.decodedRowPitch, upload.width * 4);
+                }
+
+                std::printf(" decoded_nonzero=%u/%u", nonZero, upload.width * upload.height * 4);
+                readback.decoded->unmap();
+            }
+
+            std::printf("\n");
+            reported++;
+        }
+
+        std::fflush(stdout);
+    }
