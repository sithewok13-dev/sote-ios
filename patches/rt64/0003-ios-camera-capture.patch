+        // iOS camera: copies a presented frame for the app, which saves it
+        // as a photo. Requests come from the app's camera button.
+        struct IosCapture {
+            std::unique_ptr<RenderBuffer> readbackBuffer;
+            uint32_t width = 0;
+            uint32_t height = 0;
+            uint32_t rowPitch = 0;
+        };
+
+        IosCapture queueIosCapture(RenderDevice *device, RenderCommandList *commandList, RenderTexture *swapChainTexture,
+            uint32_t width, uint32_t height, bool supportsReadback)
+        {
+            IosCapture capture;
+            if ((iosCaptureCallback == nullptr) || !supportsReadback || (width == 0) || (height == 0)) {
+                return capture;
+            }
+
+            int requests = iosCaptureRequests.load();
+            while ((requests > 0) && !iosCaptureRequests.compare_exchange_weak(requests, requests - 1)) {}
+            if (requests <= 0) {
+                return capture;
+            }
+
+            capture.width = width;
+            capture.height = height;
+            capture.rowPitch = ((width * SwapChainBytesPerPixel + TextureDataPitchAlignment - 1) / TextureDataPitchAlignment) * TextureDataPitchAlignment;
+            capture.readbackBuffer = device->createBuffer(RenderBufferDesc::ReadbackBuffer(uint64_t(capture.rowPitch) * height));
+            commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(swapChainTexture, RenderTextureLayout::COPY_SOURCE));
+            commandList->copyTextureRegion(
+                RenderTextureCopyLocation::PlacedFootprint(capture.readbackBuffer.get(), RenderFormat::B8G8R8A8_UNORM, width, height, 1, capture.rowPitch / SwapChainBytesPerPixel),
+                RenderTextureCopyLocation::Subresource(swapChainTexture));
+            return capture;
+        }
+
+        void deliverIosCapture(const IosCapture &capture) {
+            if (capture.readbackBuffer == nullptr) {
+                return;
+            }
+
+            RenderRange readRange = { 0, uint64_t(capture.rowPitch) * capture.height };
+            const uint8_t *pixels = reinterpret_cast<const uint8_t *>(capture.readbackBuffer->map(0, &readRange));
+            if (pixels != nullptr) {
+                iosCaptureCallback(pixels, capture.width, capture.height, capture.rowPitch);
+                capture.readbackBuffer->unmap();
+            }
+        }
