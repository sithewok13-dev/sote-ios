 namespace RT64 {
+    // iOS black-screen diagnostic: at a few workloads, log what RT64 asks the
+    // GPU to draw, and read back the vertex data before and after the RSP
+    // compute pass.
+    struct WorkloadDiagnostic {
+        static constexpr uint64_t VertexBytes = 16 * sizeof(float) * 4;
+        bool active = false;
+        std::unique_ptr<RenderBuffer> screenPos;
+        std::unique_ptr<RenderBuffer> uploadedPos;
+        uint64_t screenPosBytes = 0;
+        uint64_t uploadedPosBytes = 0;
+    };
+
+    static bool isDiagnosticWorkload(uint64_t workloadNumber) {
+        return (workloadNumber == 240) || (workloadNumber == 900);
+    }
+
+    static void logReadback(const char *name, RenderBuffer *buffer, uint64_t bytes) {
+        if ((buffer == nullptr) || (bytes == 0)) {
+            std::printf("[ios][workload] %s: none\n", name);
+            return;
+        }
+
+        RenderRange range = { 0, bytes };
+        const float *values = reinterpret_cast<const float *>(buffer->map(0, &range));
+        if (values == nullptr) {
+            std::printf("[ios][workload] %s: map failed\n", name);
+            return;
+        }
+
+        const uint32_t count = uint32_t(std::min<uint64_t>(bytes / sizeof(float), 16));
+        std::printf("[ios][workload] %s:", name);
+        for (uint32_t i = 0; i < count; i++) {
+            std::printf(" %.2f", values[i]);
+        }
+
+        std::printf("\n");
+        buffer->unmap();
+    }
+
