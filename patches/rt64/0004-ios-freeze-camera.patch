+    void State::iosFreezeUpdateCamera() {
+        DebuggerCamera &camera = debuggerInspector.camera;
+        const IosFreezeBase &base = iosFreezeBase;
+        const float yaw = base.yaw + iosFreezeYaw.load();
+        const float pitch = std::clamp(base.pitch + iosFreezePitch.load(), -1.4f, 1.4f);
+        const float radius = base.radius * std::clamp(iosFreezeZoom.load(), 0.15f, 4.0f);
+        const hlslpp::float3 direction = (base.across * std::sin(yaw) + base.back * std::cos(yaw)) * std::cos(pitch) + base.up * std::sin(pitch);
+        const hlslpp::float3 focus = base.pivot;
+        const hlslpp::float3 position = focus + direction * radius;
+        iosFreezeLookAt(camera, position, focus, base.up, base.viewScale);
+        const hlslpp::float3 pan = hlslpp::normalize(camera.invViewMatrix[0].xyz) * (iosFreezePanX.load() * radius) +
+            hlslpp::normalize(camera.invViewMatrix[1].xyz) * (iosFreezePanY.load() * radius);
+        iosFreezeLookAt(camera, position + pan, focus + pan, base.up, base.viewScale);
+        camera.iosDelta = hlslpp::mul(base.gameInvView, camera.viewMatrix);
+    }
