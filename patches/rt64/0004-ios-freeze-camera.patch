+        void iosFreezeLookAt(DebuggerCamera &camera, hlslpp::float3 position, hlslpp::float3 focus, hlslpp::float3 up, float viewScale) {
+            const hlslpp::float3 forward = hlslpp::normalize(position - focus);
+            const hlslpp::float3 side = hlslpp::normalize(hlslpp::cross(up, forward));
+            const hlslpp::float3 viewUp = hlslpp::normalize(hlslpp::cross(forward, side));
