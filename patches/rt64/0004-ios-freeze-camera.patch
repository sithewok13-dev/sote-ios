+            camera.invViewMatrix[2] = hlslpp::float4(forward * viewScale, 0.0f);
+            camera.invViewMatrix[3] = hlslpp::float4(position, 1.0f);
+            camera.viewMatrix = hlslpp::inverse(camera.invViewMatrix);
+        }
