+        const float pitch = std::clamp(iosFreezeBase.pitch + iosFreezePitch.load(), -1.4f, 1.4f);
+        const float radius = iosFreezeBase.radius * std::clamp(iosFreezeZoom.load(), 0.15f, 4.0f);
+        const hlslpp::float3 direction(std::cos(pitch) * std::sin(yaw), std::sin(pitch), std::cos(pitch) * std::cos(yaw));
+        hlslpp::float3 focus = iosFreezeBase.pivot;
+        hlslpp::float3 position = focus + direction * radius;
+        iosFreezeLookAt(camera, position, focus);
+        const hlslpp::float3 pan = camera.invViewMatrix[0].xyz * (iosFreezePanX.load() * radius) +
+            camera.invViewMatrix[1].xyz * (iosFreezePanY.load() * radius);
+        iosFreezeLookAt(camera, position + pan, focus + pan);
+    }
