+    // iOS freeze camera: takes the game's own camera from the last workload,
+    // pauses like the debugger does, and orbits around a pivot (Dash, as the
+    // app reports him) by the app's yaw, pitch, zoom and pan. The orbit turns
+    // round the world's up axis, taken from the game camera, so the view
+    // never rolls; the pivot is placed relative to the game camera, so it
+    // does not matter how RT64's world space relates to the game's.
+    bool State::iosFreezeStart() {
+        const Workload &workload = ext.workloadQueue->workloads[ext.workloadQueue->previousWriteCursor()];
+        const Projection *best = nullptr;
+        for (uint32_t f = 0; f < workload.fbPairCount; f++) {
+            const FramebufferPair &fbPair = workload.fbPairs[f];
+            for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+                const Projection &proj = fbPair.projections[p];
+                if ((proj.type == Projection::Type::Perspective) && ((best == nullptr) || (proj.gameCallCount > best->gameCallCount))) {
+                    best = &proj;
+                }
+            }
+        }
+
+        if ((best == nullptr) || (best->transformsIndex >= workload.drawData.viewTransforms.size())) {
+            return false;
+        }
+
+        // What the frame is made of, for the log: every perspective
+        // projection's draw count and camera (position and facing).
+        for (uint32_t f = 0; f < workload.fbPairCount; f++) {
+            const FramebufferPair &fbPair = workload.fbPairs[f];
+            for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+                const Projection &proj = fbPair.projections[p];
+                if ((proj.type != Projection::Type::Perspective) || (proj.transformsIndex >= workload.drawData.viewTransforms.size())) {
+                    continue;
+                }
+
+                const hlslpp::float4x4 inv = hlslpp::inverse(hlslpp::float4x4(workload.drawData.viewTransforms[proj.transformsIndex]));
+                std::printf("[ios][freeze] fb %u proj %u calls %u%s pos %.1f %.1f %.1f back %.2f %.2f %.2f up %.2f %.2f %.2f\n",
+                    f, p, proj.gameCallCount, (&proj == best) ? " (main)" : "",
+                    float(inv[3].x), float(inv[3].y), float(inv[3].z),
+                    float(inv[2].x), float(inv[2].y), float(inv[2].z),
+                    float(inv[1].x), float(inv[1].y), float(inv[1].z));
+            }
+        }
+
+        DebuggerCamera &camera = debuggerInspector.camera;
+        camera.enabled = true;
+        camera.sceneIndex = 0;
+        camera.viewMatrix = workload.drawData.viewTransforms[best->transformsIndex];
+        camera.invViewMatrix = hlslpp::inverse(camera.viewMatrix);
+        camera.projMatrix = workload.drawData.projTransforms[best->transformsIndex];
+        camera.iosRelative = true;
+        camera.iosDelta = hlslpp::float4x4::identity();
+        iosFreezeBase.gameInvView = camera.invViewMatrix;
+
+        // RT64's camera: position, and side/up/back axes with their length
+        // (the game's view may carry a scale, which the orbit keeps).
+        const hlslpp::float3 position = camera.invViewMatrix[3].xyz;
+        const float scale = float(hlslpp::length(camera.invViewMatrix[2].xyz));
+        const hlslpp::float3 back = hlslpp::normalize(camera.invViewMatrix[2].xyz);
+        const hlslpp::float3 up = iosNearestAxis(camera.invViewMatrix[1].xyz);
+        if (!iosFinite(position) || !iosFinite(back) || !std::isfinite(scale) || (scale <= 0.0f)) {
+            return false;
+        }
+
+        hlslpp::float3 forward = -back;
+        hlslpp::float3 right = hlslpp::cross(forward, up);
+        if (float(hlslpp::length(right)) < 0.01f) {
+            right = hlslpp::float3(camera.invViewMatrix[0].xyz);
+        }
+
+        right = hlslpp::normalize(right);
+        const hlslpp::float3 viewUp = hlslpp::normalize(hlslpp::cross(right, forward));
+
+        // The game's own camera and Dash, in its units (z up). Place Dash
+        // the same way relative to RT64's camera. World units per game unit:
+        // the game camera and RT64's sit at the same point when the spaces
+        // only differ by scale; otherwise assume 1. Without Dash, orbit a
+        // point a little ahead of the camera.
+        hlslpp::float3 pivot = position + forward * 25.0f;
+        float minRadius = 0.0f;
+        if (iosFreezeHasEye.load() && iosFreezeHasPivot.load()) {
+            const hlslpp::float3 eye(iosFreezeEye[0].load(), iosFreezeEye[1].load(), iosFreezeEye[2].load());
+            const hlslpp::float3 player(iosFreezePivot[0].load(), iosFreezePivot[1].load(), iosFreezePivot[2].load());
+            const hlslpp::float3 gameForward = hlslpp::normalize(hlslpp::float3(iosFreezeForward[0].load(), iosFreezeForward[1].load(), iosFreezeForward[2].load()));
+            const hlslpp::float3 gameUpAxis(0.0f, 0.0f, 1.0f);
+            hlslpp::float3 gameRight = hlslpp::cross(gameForward, gameUpAxis);
+            if (iosFinite(eye) && iosFinite(player) && iosFinite(gameForward) && (float(hlslpp::length(gameRight)) > 0.01f)) {
+                gameRight = hlslpp::normalize(gameRight);
+                const hlslpp::float3 gameUp = hlslpp::normalize(hlslpp::cross(gameRight, gameForward));
+                float unit = 1.0f;
+                const float eyeLength = float(hlslpp::length(eye));
+                const float positionLength = float(hlslpp::length(position));
+                if ((eyeLength > 1.0f) && (positionLength > 0.0f) &&
+                    (float(hlslpp::dot(eye / eyeLength, position / positionLength)) > 0.995f)) {
+                    unit = positionLength / eyeLength;
+                }
+
+                const hlslpp::float3 offset = player - eye;
+                const float along = float(hlslpp::dot(offset, gameForward));
+                const float side = float(hlslpp::dot(offset, gameRight));
+                const float lift = float(hlslpp::dot(offset, gameUp));
+                const float reach = float(hlslpp::length(offset));
+                if ((along > 0.0f) && (reach < 2000.0f)) {
+                    pivot = position + (forward * along + right * side + viewUp * lift) * unit;
+                    const float size = iosFreezeSize.load();
+                    if (std::isfinite(size) && (size > 0.0f) && (size < 200.0f)) {
+                        minRadius = 6.0f * size * unit;
+                    }
+                }
+            }
+        }
+
+        const hlslpp::float3 offset = position - pivot;
+        hlslpp::float3 flatBack = back - up * float(hlslpp::dot(back, up));
+        if (float(hlslpp::length(flatBack)) < 0.01f) {
+            flatBack = viewUp - up * float(hlslpp::dot(viewUp, up));
+        }
+
+        iosFreezeBase.pivot = pivot;
+        iosFreezeBase.up = up;
+        iosFreezeBase.back = hlslpp::normalize(flatBack);
+        iosFreezeBase.across = hlslpp::normalize(hlslpp::cross(up, iosFreezeBase.back));
+        iosFreezeBase.viewScale = scale;
+        iosFreezeBase.radius = std::max(float(hlslpp::length(offset)), 0.01f);
+        iosFreezeBase.yaw = std::atan2(float(hlslpp::dot(offset, iosFreezeBase.across)), float(hlslpp::dot(offset, iosFreezeBase.back)));
+        iosFreezeBase.pitch = std::asin(std::clamp(float(hlslpp::dot(offset, up)) / iosFreezeBase.radius, -1.0f, 1.0f));
+        if (minRadius > 0.0f) {
+            // A close shoulder camera looks steeply down on him: frame him
+            // from a few body heights back, a little above.
+            iosFreezeBase.radius = std::max(iosFreezeBase.radius, minRadius);
+            iosFreezeBase.pitch = std::clamp(iosFreezeBase.pitch, 0.12f, 0.45f);
+        }
+        std::printf("[ios][freeze] pivot %.1f %.1f %.1f radius %.1f yaw %.2f pitch %.2f scale %.3f eye %d player %d size %.1f workloads %u\n",
+            float(pivot.x), float(pivot.y), float(pivot.z), iosFreezeBase.radius, iosFreezeBase.yaw, iosFreezeBase.pitch, scale,
+            int(iosFreezeHasEye.load()), int(iosFreezeHasPivot.load()), iosFreezeSize.load(), uint32_t(ext.workloadQueue->workloads.size()));
+        std::printf("[ios][freeze] game eye %.1f %.1f %.1f forward %.2f %.2f %.2f player %.1f %.1f %.1f\n",
+            iosFreezeEye[0].load(), iosFreezeEye[1].load(), iosFreezeEye[2].load(),
+            iosFreezeForward[0].load(), iosFreezeForward[1].load(), iosFreezeForward[2].load(),
+            iosFreezePivot[0].load(), iosFreezePivot[1].load(), iosFreezePivot[2].load());
+        std::fflush(stdout);
+        debuggerInspector.paused = true;
+        return true;
+    }
